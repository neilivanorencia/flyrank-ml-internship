{
  "name": "click-shortfall-capstone",
  "description": "Which pages keep losing the clicks they should be getting? A test of whether the shortfall is more than bad luck, and whether it lasts into next month.",
  "author": {
    "name": "Neil Ivan Orencia",
    "email": "neilivanorencia@protonmail.com",
    "url": "https://github.com/neilivanorencia"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/neilivanorencia/flyrank-ml-internship.git",
    "directory": "paper"
  },
  "type": "module",
  "private": true,
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "data": "node scripts/extract-data.ts",
    "lint": "oxlint && stylelint \"**/*.{css,astro}\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "astro check",
    "build": "astro check && astro build && node scripts/check-build.ts",
    "preview": "astro preview",
    "prepare": "cd .. && husky paper/.husky"
  },
  "lint-staged": {
    "*.{ts,mjs,js,astro}": [
      "oxlint --fix"
    ],
    "*.{css,astro}": [
      "stylelint --fix"
    ],
    "*.{ts,mjs,js,astro,css,json,md,yml}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@phosphor-icons/core": "2.1.1",
    "astro": "7.3.6",
    "d3-array": "3.2.4",
    "d3-format": "3.1.2",
    "d3-scale": "4.0.2",
    "lenis": "1.3.26",
    "motion": "14.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@types/d3-array": "3.2.2",
    "@types/d3-format": "3.0.4",
    "@types/d3-scale": "4.0.9",
    "@types/node": "24.19.1",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "oxlint": "1.87.0",
    "oxlint-tsgolint": "7.0.2003",
    "postcss-html": "2.0.0",
    "prettier": "3.9.9",
    "prettier-plugin-astro": "1.1.0",
    "stylelint": "17.16.0",
    "stylelint-config-html": "2.0.0",
    "stylelint-config-recess-order": "7.8.0",
    "stylelint-config-standard": "40.0.0",
    "typescript": "6.0.3"
  }
}
