---
/**
 * The site's top navigation bar with the brand, the section links, the theme toggle, and a link to the notebooks.
 */

import GithubIcon from "@phosphor-icons/core/assets/regular/github-logo.svg";

import Logo from "@/components/logo.astro";
import ThemeToggle from "@/components/theme-toggle.astro";
import { NOTEBOOKS_URL } from "@/lib/links";

/** The in-page links shown in the top bar, each pointing at a section id. */
const links = [
  { href: "#abstract", label: "Abstract" },
  { href: "#method", label: "Method" },
  { href: "#results", label: "Results" },
  { href: "#playbook", label: "Playbook" },
] as const;
---

{/* The top bar, with the brand on the left and the section links, theme toggle, and notebooks button on the right. */}
<nav class="navigation" aria-label="Paper">
  {/* The brand link returns to the top of the main content. */}
  <a class="navigation__brand" href="#main">
    <Logo />
    <span class="navigation__name">FlyRank Internship</span>
    <span class="navigation__divider" aria-hidden="true"></span>
    <span class="navigation__title">Click Shortfall</span>
  </a>
  <div class="navigation__actions">
    <ul class="navigation__links">
      {links.map((link) => (
        <li>
          <a class="navigation__link" href={link.href}>
            {link.label}
          </a>
        </li>
      ))}
    </ul>
    <ThemeToggle />
    {/* The call to action sends readers to the notebooks that hold the analysis. */}
    <a class="navigation__cta" href={NOTEBOOKS_URL}>
      <GithubIcon class="navigation__cta-icon" aria-hidden="true" />
      Notebooks
    </a>
  </div>
</nav>

<style>
  .navigation {
    /* Sets the theme toggle's border to the dark bar's line color instead of the current text color. */
    --toggle-line: var(--night-line);

    display: flex;
    gap: var(--space-4);
    align-items: center;
    justify-content: space-between;
    min-height: 4.5rem;
    color: var(--on-night);
  }

  .navigation__brand {
    display: inline-flex;
    gap: var(--space-3);
    align-items: center;
    min-height: 2.75rem;
    color: inherit;
    text-decoration: none;
  }

  .navigation__name {
    font-weight: 600;
  }

  .navigation__divider {
    width: 1px;
    height: 1rem;
    background-color: var(--night-line);
  }

  .navigation__title {
    font-size: 0.875rem;
    color: var(--on-night-2);
  }

  .navigation__actions {
    display: flex;
    gap: var(--space-4);
    align-items: center;
  }

  .navigation__links {
    display: flex;
    gap: var(--space-5);
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .navigation__link {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    font-size: 0.875rem;
    color: var(--on-night-2);
    text-decoration: none;

    &:hover {
      color: var(--on-night);
    }
  }

  .navigation__cta {
    display: inline-flex;
    gap: var(--space-2);
    align-items: center;
    min-height: 2.75rem;
    padding: 0 var(--space-4);
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--night);
    text-decoration: none;
    background-color: var(--accent);
    border-radius: var(--radius-pill);
  }

  .navigation__cta-icon {
    width: 1rem;
    height: 1rem;
  }

  /* Narrow screens keep only the brand and the theme toggle. */
  @media (width < 48rem) {
    .navigation__links,
    .navigation__cta,
    .navigation__title,
    .navigation__divider {
      display: none;
    }
  }
</style>
