---
import ArrowUpRightIcon from "@phosphor-icons/core/assets/regular/arrow-up-right.svg";

import Card from "@/components/card.astro";
import FactStrip from "@/components/fact-strip.astro";
import LinkCard from "@/components/link-card.astro";
import SectionHeader from "@/components/section-header.astro";
import { COLAB_URL, FLYRANK_URL, NOTEBOOK_URL, PDF_URL, REPOSITORY_URL } from "@/lib/links";

const facts = [
  { code: "42", label: "Seed", value: "everywhere" },
  {
    chips: [
      { name: "scikit-learn", version: "1.6.1" },
      { name: "pandas", version: "2.2.3" },
      { name: "numpy", version: "2.1.3" },
    ],
    label: "Versions",
    value: "",
  },
  {
    code: "HF_TOKEN",
    label: "Access",
    value: "as an environment variable or Colab Secret, never in a cell",
  },
] as const;
---

<section
  class="close backdrop backdrop--grid"
  style="

--orb-position: 15% 90%"
  aria-label="Reproducibility and credits"
>
  <div class="close__inner wide">
    <section
      class="close__reproducibility"
      id="reproducibility"
      aria-labelledby="reproducibility-title"
    >
      <SectionHeader id="reproducibility-title" number="7" title="Reproducibility" onDark />
      <p class="close__text">
        Every number on this page is read from the saved outputs of seven weekly notebooks, each run
        top to bottom on Google Colab. The capstone notebook re-reads them and checks every figure
        it quotes.
      </p>
      <div class="close__links">
        <LinkCard
          download
          href={PDF_URL}
          icon="pdf"
          title="Full report (PDF)"
          subtitle="30 slides, with bookmarks"
        />
        <LinkCard
          href={REPOSITORY_URL}
          icon="repository"
          title="Repository"
          subtitle="Code, notebooks, outputs"
        />
        <LinkCard
          href={NOTEBOOK_URL}
          icon="notebook"
          title="Capstone notebook"
          subtitle="Re-checks every number it quotes"
        />
        <LinkCard
          href={COLAB_URL}
          icon="colab"
          title="Open in Colab"
          subtitle="No token needed to read"
        />
      </div>
    </section>
    <div class="close__manifest">
      <FactStrip variant="keyed" items={facts} />
    </div>
    <section class="close__credits" id="acknowledgments" aria-labelledby="acknowledgments-title">
      <Card tone="raised" size="large">
        <h2 class="close__credits-title" id="acknowledgments-title">
          Acknowledgments & data credit
        </h2>
        <p class="close__credits-text">
          Data provided by FlyRank through the FlyRank ML Internship warehouse, release v20260703,
          pseudonymized before release. No client name, URL, or search query appears anywhere in
          this work.
        </p>
        <a class="close__credits-link" href={FLYRANK_URL}>
          flyrank.ai
          <ArrowUpRightIcon class="close__credits-icon" aria-hidden="true" />
        </a>
        <hr class="close__rule" />
        <p class="close__credits-text">
          Thanks to FlyRank for the warehouse, the lane brief, and the internship that made this
          work possible.
        </p>
      </Card>
    </section>
  </div>
</section>

<style>
  .close {
    padding-block: clamp(4rem, 3rem + 4vw, 6.5rem) var(--space-7);
    color: var(--on-night-2);
    background-color: var(--band-bg);
  }

  .close__inner {
    display: grid;
    gap: var(--space-6);
    align-items: start;
  }

  .close__credits {
    margin-block-start: var(--space-6);
  }

  .close__reproducibility {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .close__text {
    font-size: 1.0625rem;
    line-height: 1.6;
    color: var(--on-night-2);
  }

  .close__links {
    display: grid;
    gap: var(--space-3);
  }

  .close__credits-title {
    font-size: var(--text-h3);
    color: var(--on-night);
    letter-spacing: -0.025em;
  }

  .close__credits-text {
    font-size: var(--text-label);
    line-height: 1.6;
    color: var(--on-night-2);
  }

  .close__credits-link {
    display: inline-flex;
    gap: var(--space-2);
    align-items: center;
    min-height: 2.75rem;
    font-size: var(--text-label);
    font-weight: 600;
    color: var(--accent);
  }

  .close__credits-icon {
    width: 1rem;
    height: 1rem;
  }

  .close__rule {
    width: calc(100% + 2 * var(--space-6));
    height: 1px;
    margin: 0 calc(-1 * var(--space-6));
    background-color: var(--night-line);
    border: 0;
  }

  @media (width >= 40rem) {
    .close__links {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (width >= 64rem) {
    .close__inner {
      grid-template:
        "intro credits" auto
        "manifest manifest" auto
        / minmax(0, 1fr) 25rem;
      gap: var(--space-7) var(--space-8);
    }

    .close__reproducibility {
      grid-area: intro;
    }

    .close__manifest {
      grid-area: manifest;
    }

    .close__credits {
      display: flex;
      grid-area: credits;
      align-self: stretch;
      margin-block-start: 0;

      > :global(.card) {
        flex: 1;
      }
    }

    .close__rule {
      margin-block-start: auto;
    }
  }
</style>
