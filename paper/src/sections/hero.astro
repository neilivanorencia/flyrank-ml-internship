---
import ArrowDownIcon from "@phosphor-icons/core/assets/regular/arrow-down.svg";
import FilePdfIcon from "@phosphor-icons/core/assets/regular/file-pdf.svg";

import Funnel from "@/charts/funnel.astro";
import Yardstick from "@/charts/yardstick.astro";
import { PDF_URL } from "@/lib/links";
---

<section class="hero backdrop backdrop--grid" aria-labelledby="hero-title" data-toc-after>
  <div class="hero__body wide">
    <div class="hero__copy">
      <h1 class="hero__title" id="hero-title">
        Which pages keep <span class="hero__accent">losing the clicks</span> they should be getting?
      </h1>
      <p class="hero__subtext">
        Some pages rank well on Google yet get far fewer clicks than they should. This work finds
        them, tests whether the gap is more than bad luck, and checks whether it lasts into the next
        month.
      </p>
      <div class="hero__actions">
        <a class="hero__cta hero__cta--primary" href="#results">
          See the findings
          <ArrowDownIcon class="hero__icon" aria-hidden="true" />
        </a>
        <a class="hero__cta hero__cta--secondary" href="#playbook">
          See the playbook
        </a>
        <a class="hero__cta hero__cta--link" href={PDF_URL} download>
          <FilePdfIcon class="hero__icon hero__icon--pdf" aria-hidden="true" />
          Download report
          <span class="visually-hidden"> (PDF, 7 MB, a supplementary copy of this page)</span>
        </a>
      </div>
    </div>
    <Yardstick />
  </div>
  <div class="hero__facts wide">
    <Funnel />
  </div>
</section>

<style>
  .hero {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
    padding-block: calc(4.5rem + var(--space-8)) var(--space-7);
    color: var(--on-night-2);
    background-color: var(--night);
  }

  .hero__body {
    display: grid;
    gap: var(--space-7) var(--space-8);
    align-items: center;
  }

  .hero__copy {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  .hero__title {
    color: var(--on-night);
  }

  .hero__accent {
    color: var(--accent);
  }

  .hero__subtext {
    font-size: var(--text-lead);
    line-height: 1.55;
    color: var(--on-night-2);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    align-items: center;
    padding-block-start: var(--space-2);
  }

  .hero__cta {
    display: inline-flex;
    gap: var(--space-2);
    align-items: center;
    justify-content: center;
    min-height: 3rem;
    padding: 0 var(--space-5);
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--on-night);
    text-decoration: none;
    border-radius: var(--radius-pill);
    transition:
      background-color 160ms ease-out,
      transform 160ms ease-out;

    &:active {
      transform: scale(0.98);
    }
  }

  .hero__cta--primary {
    font-weight: 600;
    color: var(--night);
    background-color: var(--accent);

    &:hover {
      background-color: var(--mint-soft);
    }
  }

  .hero__cta--secondary {
    border: 1px solid var(--night-line);

    &:hover {
      background-color: var(--night-raised);
    }
  }

  .hero__cta--link {
    padding-inline: var(--space-1);

    &:hover {
      color: var(--accent);
    }
  }

  .hero__icon {
    width: 1rem;
    height: 1rem;
  }

  .hero__icon--pdf {
    width: 1.125rem;
    height: 1.125rem;
    color: var(--accent);
  }

  .hero__facts {
    padding-block-start: var(--space-7);
    border-block-start: 1px solid var(--night-line);
  }

  @media (width >= 64rem) {
    .hero__body {
      grid-template-columns: minmax(0, 37.5rem) minmax(0, 25rem);
      justify-content: space-between;
    }
  }

  @media (width < 48rem) {
    .hero {
      gap: var(--space-6);
      padding-block-start: calc(4.5rem + var(--space-4));
    }

    .hero__cta--primary,
    .hero__cta--secondary {
      flex: 1 1 100%;
    }

    .hero__cta--link {
      display: none;
    }
  }
</style>
